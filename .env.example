# Public DNS name pointing at this server.
DOMAIN=chat.example.com

# The shared login name shown by the browser's Basic Auth prompt.
BASIC_AUTH_USER=admin

# Generate this on the server with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'replace-me'
BASIC_AUTH_HASH=replace-with-a-caddy-bcrypt-hash
